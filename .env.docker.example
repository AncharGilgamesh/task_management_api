# Только для локального Docker Compose. Не использовать как production-секреты.
# Запуск с этими значениями:
#   docker compose --env-file .env.docker.example up --build
#
# Приложение получит DATABASE_URL вида
# postgresql+asyncpg://task_user:task_password@db:5432/task_management
# Хост db — это сервис PostgreSQL внутри сети Compose, не localhost.

POSTGRES_USER=task_user
POSTGRES_PASSWORD=task_password
POSTGRES_DB=task_management
# Порт на хосте. 5433, чтобы не конфликтовать с локальным PostgreSQL на 5432.
POSTGRES_PORT=5433
APP_PORT=8000

# Минимум 32 символа. Замените перед любой публикацией наружу.
DOCKER_SECRET_KEY=local-only-docker-secret-key-not-for-production-01
ACCESS_TOKEN_EXPIRE_MINUTES=30
DB_ECHO=false
